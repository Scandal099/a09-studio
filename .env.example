# Публичный адрес вашего сайта на российском хостинге (без завершающего слэша)
# ВАЖНО: задайте этот параметр ДО запуска `npm run build` (включает HTTPS HSTS и канонические ссылки)
NEXT_PUBLIC_SITE_URL=https://example.ru

# Разрешённые Origin для POST /api/inquiries (через запятую)
ALLOWED_ORIGINS=https://example.ru,https://www.example.ru

# Включите true ТОЛЬКО если перед Node.js стоит доверенный прокси (Nginx/Caddy),
# который перезаписывает X-Real-IP или дописывает реальный IP клиента справа в X-Forwarded-For
TRUST_PROXY=false

# Telegram-бот для оперативных уведомлений о новых заявках
# 1) Создайте бота у @BotFather и вставьте токен сюда
# 2) Узнайте свой chat_id (например, через @userinfobot) и напишите боту /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Передавать ли имя/контакт/описание клиента в уведомлении Telegram (true)
# или отправлять только обезличенный сигнал с номером заявки #REF и форматом (false).
# При true — подайте уведомление о трансграничной передаче ПДн в РКН (ст. 12 152-ФЗ).
# При false — персональные данные вообще не покидают российский сервер.
TELEGRAM_INCLUDE_PII=true

# Папка локального первичного журнала заявок на сервере в РФ (ч. 5 ст. 18 152-ФЗ)
# Заявки пишутся в ${INQUIRIES_DATA_DIR}/inquiries-YYYY-MM.jsonl с правами 0600
INQUIRIES_DATA_DIR=./data

# Опционально: ID счётчика Яндекс Метрики (только цифры, например 98765432)
# Пока переменная пуста — скрипт аналитики и баннер cookie не загружаются
NEXT_PUBLIC_YM_ID=

# Опционально: внешний URL API заявок, если фронтенд тестируется отдельно
NEXT_PUBLIC_INQUIRY_API=
